// =====================================================================
// 무비무비 (MovieMoobee) — ERD  (기획 10단계)
// dbdiagram.io 에 그대로 붙여넣어 사용하세요.  https://dbdiagram.io
// 스택: 프론트 Vue · 백엔드 Django REST Framework · DB PostgreSQL (확정)
//   - 테이블 = Django 모델, 기본 PK = BigAutoField(id)
//   - 좌표 근접 검색이 필요해지면 PostgreSQL pgvector 확장 활용 가능
//
// 메모
//  - 영화 좌표(umap_x, umap_y)는 전역 고정값 → movies 에 컬럼으로 저장
//  - 사용자 좌표(coord_x, coord_y)는 별점 가중 파생값 → users 에 캐싱(별점 변경 시 갱신)
//  - 시청기록 = 등록 + 별점(필수) + 리뷰(선택)  하나로 통합 (별도 review 테이블 없음)
//  - 이용자 리뷰 목록 = watch_records 에서 review IS NOT NULL 조회
//  - OTT 제공 정보는 자주 바뀜(구독사 사정) → 저장 안 함, TMDB watch providers 조회 시점에 가져옴
//  - 예고편(trailer_key)은 거의 불변 → movies 컬럼에 저장(import 적재), 상세에서 실시간 호출 없이 즉시 노출
//  - 친구 = 요청·수락(맞팔)만. friendships 한 행으로 양방향 관계 표현
//  - 알림 = 친구 요청/수락 시 Signal로 생성(인앱). notifications 테이블, 실시간 push 없음
// =====================================================================

Enum friendship_status {
  pending
  accepted
}

Enum notification_type {
  friend_request
  friend_accept
}

// User 는 Django AbstractUser 상속 → 아래 외에 is_staff·is_superuser·is_active·
// last_login·first_name·last_name 등 인증 기본 컬럼도 실제로 존재(가독성 위해 생략).
Table users {
  id                bigint        [pk, increment]
  username          varchar(150)  [not null, unique, note: '실제 고유 식별자 — 회원가입 시 email로 자동 생성(allauth)']
  email             varchar(254)  [note: '앱레벨 unique(allauth ACCOUNT_UNIQUE_EMAIL); DB 컬럼 자체는 비고유·blank 허용']
  password          varchar(128)  [not null, note: 'Django 해시 저장']
  nickname          varchar(50)   [not null, unique]
  profile_image_url varchar(500)  [note: 'blank/null 허용']
  onboarded         boolean       [not null, default: false, note: '온보딩(영화 5편 등록) 완료 — 한번 True면 유지(F-ONB-01)']
  coord_x           double        [note: '파생·캐싱: 별점 가중 사용자 좌표 X (F-MAP-00)']
  coord_y           double        [note: '파생·캐싱: 별점 가중 사용자 좌표 Y']
  coord_updated_at  timestamp     [note: '좌표 마지막 재계산 시각']
  date_joined       timestamp     [not null, default: `now()`, note: 'AbstractUser 가입 시각']
}

Table movies {
  id                bigint        [pk, increment]
  tmdb_id           bigint        [not null, unique]
  title             varchar(500)  [not null]
  original_title    varchar(500)
  overview          text
  release_date      date
  release_year      int
  runtime           int
  vote_average      decimal(3,1)
  vote_count        int
  original_language varchar(10)
  poster_path       varchar(500)
  director          varchar(255)
  cast              varchar(500)  [note: '주연 5명(콤마 구분)']
  trailer_key       varchar(20)   [note: '유튜브 예고편 키 (거의 불변 → DB 저장, extras 호출 절감)']
  umap_x            double        [note: '전역 좌표 X (고정)']
  umap_y            double        [note: '전역 좌표 Y (고정)']
  created_at        timestamp     [not null, default: `now()`, note: 'DB 추가 시점 → 최근 추가된 영화']
}

Table genres {
  id            bigint       [pk, increment]
  tmdb_genre_id int          [unique, note: 'TMDB 장르 id (IntegerField)']
  name          varchar(50)  [not null, unique]
}

Table movie_genres {
  movie_id bigint [not null, ref: > movies.id]
  genre_id bigint [not null, ref: > genres.id]

  indexes {
    (movie_id, genre_id) [pk]
  }
}

Table keywords {
  id   bigint        [pk, increment]
  name varchar(100)  [not null, unique]
}

Table movie_keywords {
  movie_id   bigint [not null, ref: > movies.id]
  keyword_id bigint [not null, ref: > keywords.id]

  indexes {
    (movie_id, keyword_id) [pk]
  }
}

Table watch_records {
  id         bigint        [pk, increment]
  user_id    bigint        [not null, ref: > users.id]
  movie_id   bigint        [not null, ref: > movies.id]
  rating     decimal(2,1)  [not null, note: '0.5 단위 · 필수 (좌표 가중치)']
  review     text          [note: '선택 (NULL 가능)']
  watched_on date          [note: '선택']
  created_at timestamp     [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (user_id, movie_id) [unique]
  }
}

Table friendships {
  id           bigint            [pk, increment]
  requester_id bigint            [not null, ref: > users.id]
  addressee_id bigint            [not null, ref: > users.id]
  status       friendship_status [not null, default: 'pending']
  created_at   timestamp         [not null, default: `now()`]
  responded_at timestamp         [note: '수락·거절 시각']

  indexes {
    (requester_id, addressee_id) [unique]
  }
}

Table notifications {
  id            bigint            [pk, increment]
  recipient_id  bigint            [not null, ref: > users.id, note: '알림 받는 사람']
  actor_id      bigint            [not null, ref: > users.id, note: '유발한 상대(요청자/수락자)']
  type          notification_type [not null]
  friendship_id bigint            [ref: > friendships.id, note: '관련 친구요청']
  is_read       boolean           [not null, default: false]
  created_at    timestamp         [not null, default: `now()`]

  indexes {
    (recipient_id, is_read)
  }
}
