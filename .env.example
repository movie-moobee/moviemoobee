# =====================================================================
# 무비무비 환경변수 예시. 복사해서 .env 로 만들고 값 채우면 돼:
# 명령어로 하면
#   cp .env.example .env
# .env 는 커밋 절대 금지(.gitignore 에 등록됨). 이 .env.example 만 공유한다.
# docker compose 와 Django 가 같은 값을 공유합니다.
# =====================================================================

# --- PostgreSQL ---
POSTGRES_DB=moviemoobee
POSTGRES_USER=moviemoobee
POSTGRES_PASSWORD=moviemoobee
POSTGRES_HOST=localhost          # 호스트에서 Django 개발서버 실행 시 localhost
POSTGRES_PORT=5432               # docker-compose 포트를 바꿨다면 같이 변경

# --- Django ---
# 로컬용 시크릿 키. 아래 명령으로 새로 생성해 채우면 됨(비워두면 개발용 기본값 사용):
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=여기에_생성한_시크릿_키
DJANGO_DEBUG=1

# --- TMDB ---
TMDB_API_KEY=여기에_본인_TMDB_키
